        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Container: build image",
      "type": "shell",
      "command": "docker build --network=host -t ${workspaceFolderBasename}-dev .devcontainer/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
