{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "testbench",
      "type": "promptString",
      "description": "Testbench name (sim/tb_<name>.v)",
      "default": "blink"
    }
  ],
  "tasks": [
    {
      "label": "DSH YOLO",
      "type": "shell",
      "command": "DSH_PERMISSION_MODE=danger-full-access dsh @DSH_TUI_PROFILE@",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "clear": false, "focus": true }
    },
    {
      "label": "Claude YOLO",
      "type": "shell",
      "command": "claude --dangerously-skip-permissions",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "clear": false, "focus": true }
    },
    {
      "label": "Qwen YOLO",
      "type": "shell",
      "command": "qwen --yolo",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "clear": false, "focus": true }
    },
    {
      "label": "Run pre-commit (all files)",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Update pre-commit hooks",
      "type": "shell",
      "command": "pre-commit autoupdate",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Container: build image",
      "type": "shell",
      "command": "docker build --network=host -t ${workspaceFolderBasename}-dev .devcontainer/",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Container: rebuild image",
      "type": "shell",
      "command": "docker build --network=host --no-cache -t ${workspaceFolderBasename}-dev .devcontainer/",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Container: shell",
      "type": "shell",
      "command": "docker run --rm -it --network=host --user $(id -u):$(id -g) -v ${workspaceFolder}:/workspace -w /workspace ${workspaceFolderBasename}-dev zsh",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "clear": false, "focus": true }
    },
    {
      "label": "Build: Quartus compile",
      "type": "shell",
      "command": "bash .devcontainer/run.sh --quartus \"cd quartus && test -d /opt/intelFPGA || { echo 'WARNING: Quartus not found in /opt/intelFPGA on the host'; exit 1; }; ${config:fpga.quartusBin}/quartus_sh --flow compile ${workspaceFolderBasename}\"",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Build: SOF -> SVF",
      "type": "shell",
      "command": "bash .devcontainer/run.sh --quartus \"cd quartus && test -d /opt/intelFPGA || { echo 'WARNING: Quartus not found in /opt/intelFPGA on the host'; exit 1; }; ${config:fpga.quartusBin}/quartus_cpf -c -q ${config:fpga.svfClock} -g ${config:fpga.svfVoltage} -n p output_files/${workspaceFolderBasename}.sof output_files/${workspaceFolderBasename}.svf\"",
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Upload: program SRAM (SVF)",
      "type": "shell",
      "command": "bash .devcontainer/run.sh --privileged \"openFPGALoader -c ${config:fpga.cable} quartus/output_files/${workspaceFolderBasename}.svf\"",
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Upload: build + program (full)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build: Quartus compile",
        "Build: SOF -> SVF",
        "Upload: program SRAM (SVF)"
      ],
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Run tests: simulation (iverilog)",
      "type": "shell",
      "command": "bash .devcontainer/run.sh \"mkdir -p build && iverilog -g2012 -Wall -o build/sim.vvp rtl/*.v sim/tb_${input:testbench}.v && vvp build/sim.vvp\"",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Monitor: waveform (GTKWave)",
      "type": "shell",
      "command": "bash .devcontainer/run.sh --gui \"test -f build/dump.vcd || { echo 'Run simulation first'; exit 1; }; gtkwave build/dump.vcd\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Static analysis: verilator",
      "type": "shell",
      "command": "bash .devcontainer/run.sh \"verilator --lint-only -Wall rtl/*.v\"",
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Check size: resource usage",
      "type": "shell",
      "command": "bash .devcontainer/run.sh \"cat quartus/output_files/*.fit.summary 2>/dev/null || echo 'Run Build first'\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Devices: list cables",
      "type": "shell",
      "command": "bash .devcontainer/run.sh \"openFPGALoader --list-cables\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Devices: detect cable",
      "type": "shell",
      "command": "bash .devcontainer/run.sh --privileged \"openFPGALoader -c ${config:fpga.cable} --detect\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build quartus/db quartus/incremental_db quartus/output_files",
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false }
    }
  ]
}
